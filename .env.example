# Local embeddings; model downloads once, then runs locally.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140
RAG_DENSE_WEIGHT=0.6
RAG_LEXICAL_WEIGHT=0.4
RAG_USE_FAISS=true
RAG_USE_RERANKER=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# OpenAI generation is optional and disabled by default.
ENABLE_OPENAI_GENERATION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=600
